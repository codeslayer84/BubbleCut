{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bubblecut",
  "version": "0.1.2",
  "identifier": "dk.aau.bubblecut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bubblecut",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "copyright": "© 2026 Jacob Davidsen · Big Soft Video · Aalborg University",
    "category": "public.app-category.video",
    "shortDescription": "360° video editor for research recordings",
    "longDescription": "Edits 360° video: a sphere preview, per-clip reorientation, text cards that can be burned in or exported for CAVA360VR, and GPU filters."
  },
  "mainBinaryName": "Bubblecut"
}